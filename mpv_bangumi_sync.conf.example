# mpv_bangumi_sync 配置文件示例
# 将此文件复制到 script-opts/mpv_bangumi_sync.conf 并修改相应配置

# Bangumi访问令牌（必需）
# 获取地址：https://next.bgm.tv/demo/access-token
bgm_access_token=你的访问令牌
# 番剧目录（插件只会在这些目录下激活）
# 番剧存储目录1 (播放到阈值立即标记看过)
# Windows使用分号分隔多个目录，Linux/Mac使用冒号分隔
# 示例：
# storages=D:/Anime;E:/Anime
# storages=/home/user/Anime:/mnt/nas/Anime
storages=你的番剧存储目录路径

# 番剧存储目录2（退出播放/关闭播放器/已看数量达到阈值时批量同步）
# Windows使用分号分隔多个目录，Linux/Mac使用冒号分隔
# old_ani_storages=D:/AnimeOld;E:/AnimeOld
# old_ani_storages=/home/user/AnimeOld:/mnt/nas/AnimeOld
old_ani_storages=你的番剧存储目录路径

# 补番批量同步阈值（0=不自动批量同步）
# batch_sync_threshold=12

# 自动点格子（开启/禁用）
# yes: 自动同步条目状态和单集状态
# no: 仅展示信息，不同步状态
# enable_auto_mark=yes

# 观看进度达到该比例时标记为已看（0~1）
# progress_mark_threshold=0.9

