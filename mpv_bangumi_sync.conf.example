# mpv_bangumi_sync config example
# Copy this file to script-opts/mpv_bangumi_sync.conf and edit the values.

# Bangumi access token (required)
# https://next.bgm.tv/demo/access-token
bgm_access_token=your_access_token

# Bangumi API proxy. Leave empty to disable.
# Examples:
# bgm_proxy=http://127.0.0.1:7890
# bgm_proxy=socks5://127.0.0.1:7890
# bgm_proxy=socks5h://127.0.0.1:7890
bgm_proxy=

# Storage group 1. Use semicolon on Windows and colon on Linux/Mac.
# Examples:
# storage1=D:/Anime;E:/Anime
# storage1=/home/user/Anime:/mnt/nas/Anime
storage1=your_anime_storage_path

# Storage group 2. Use semicolon on Windows and colon on Linux/Mac.
# Examples:
# storage2=D:/Anime2;E:/Anime2
# storage2=/home/user/Anime2:/mnt/nas/Anime2
storage2=your_anime_storage_path

# Batch sync thresholds.
# Flush immediately when pending episodes in the storage group reach the threshold.
# 0 means no count-based auto flush; pending episodes are still flushed on exit.
storage1_batch_sync_threshold=1
storage2_batch_sync_threshold=4

# Auto mark watched episodes.
# yes: update subject and episode status
# no: only show information, do not write status
# enable_auto_mark=yes

# Mark as watched when playback progress reaches this ratio (0~1).
# progress_mark_threshold=0.9
